---
import Layout from '../layouts/Layout.astro';

import CompaniesList from '../components/CompaniesList.astro';
import InProgressTags from '../components/InProgressTags.astro';
import ProjectsList from '../components/ProjectsList.astro';
import SocialLinks from '../components/SocialLinks.astro';
import { Image } from 'astro:assets';
import headshot from '../assets/images/headshot-3.webp';

---

<Layout title="Niklas Lepistö - Full Stack Developer + Designer">
	<main class="grid relative">
		<header class="grid grid-cols-1 md:grid-cols-5 gap-12 md:gap-24 p-8 pb-12 py-24 container mx-auto">
			<div class="animate-fade-right md:col-span-2 brightness-105 rounded-lg overflow-hidden shadow drop-shadow-2xl ring-2 ring-neutral-300 border border-background order-last md:order-first">
				<Image src={headshot} class="w-full object-cover h-full max-h-1/2 md:max-h-auto object-top" alt="Niklas Lepistö">
			</div>

			<section class="md:col-span-3 items-center grid order-first md:order-last">
				<div class="grid gap-4 ">

					<h1 class="animate-fade-right animate-delay-200 text-4xl leading-none">
						Niklas
						<span class="inline-block relative group">
							<span class="w-[17%] h-[12%] bg-black absolute -right-[2%] top-[7.5%] block"></span>
							<span class="w-[2%] h-[20%] bg-background absolute left-[14%] bottom-[17.5%] block"></span>
							Lepisto
						</span>
					</h1>

					<h2 class="animate-fade-right animate-delay-150 prose text-md">
						I'm a Full Stack Developer + Designer combo. I love to create experiences and experiment with new technologies, and I'm always looking to learn more.
						I try to inspire others to learn, experiment, and go after what they truly want to do by sharing as much as I can about myself.
					</h2>

					<SocialLinks />
				</div>
			</section>
		</header>

		<section class="w-full bg-gradient-to-b to-[#f3f3f3] from-background">
			<div class="container mx-auto p-8 md:pb-16 mb-12 md:mb-24 animate-fade-right animate-delay-300">
				<h2>Some brands I've worked with:</h2>
				<span class="text-xs italic">as a direct employee or in a client project via an employer</span>

				<CompaniesList />
			</div>
		</section>

		<section class="overflow-hidden bg-gradient-to-b relative from-[#f3f3f3] to-background py-14 pb-24">
			<h2 class="text-neutral-200 text-3xl z-10 relative mx-auto container px-8 animate-fade animate-delay-750">
				Some projects
			</h2>

			<ProjectsList />
		</section>
		
		<section class="py-36 overflow-hidden">
			<h2 class="text-neutral-200 text-3xl mb-8 mx-auto container px-8 animate-fade animate-delay-750">
				Few things in progress
			</h2>

			<InProgressTags />
		</section>
	</main>

	<footer class="w-full xl:pt-24 p-8 xl:p-16 grid text-xs text-neutral-300 justify-center text-center bg-gradient-to-b from-background to-[#e7e7eb]">
		<p class="w-fit mx-auto">© Niklas Lepistö 2024</p>
	</footer>
</Layout>


